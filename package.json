{
  "name": "cat-learning-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "quality:check": "biome check",
    "quality:fix": "node scripts/quality-fix.mjs",
    "structure:check": "node scripts/check-boundaries.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "smoke:pwa": "node scripts/pwa-smoke.mjs",
    "desktop:config:check": "node scripts/check-desktop-config.mjs",
    "desktop:check": "npm run desktop:config:check && cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tauri-apps/cli": "^2.11.4",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
