# Copy to a file outside Git, replace every example value, then pass it with --env-file.
CAT_GAME_BACKEND_PATH=../cat-game-backend
CAT_GAME_PUBLIC_ORIGIN=https://nyang.example.com
CAT_GAME_HTTP_PORT=8080
CAT_GAME_DB_PASSWORD=replace-with-random-password
CAT_GAME_DATABASE_URL=postgresql+psycopg://cat_game:replace-with-random-password@db:5432/cat_game
CAT_GAME_AUTH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes
CAT_GAME_GRADING_DOCKER_HOST=tcp://grading-sandbox.example.internal:2376
CAT_GAME_GRADING_CERT_PATH=/srv/nyang/secrets/grading-docker
CAT_GAME_GRADING_DOCKER_TLS_VERIFY=1
CAT_GAME_GRADING_IMAGE=cat-game-python-grader:3.12
CAT_GAME_SESSION_DAYS=30
